# Optional configuration for the GENOVA FastAPI service.
# Copy to .env and export the values (or set them in your shell/process manager).

# Comma-separated browser origins allowed to call the API.
GENOVA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Bind address and port used by `python api.py`.
GENOVA_API_HOST=127.0.0.1
GENOVA_API_PORT=8000

# Set to 1 to enable the auto-reloader when launching via `python api.py`.
GENOVA_API_RELOAD=0
