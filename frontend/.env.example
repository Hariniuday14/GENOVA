# Leave unset during development: Vite proxies /api to http://127.0.0.1:8000.
# Set this when the built frontend is served from a different origin than the API.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: change the proxy target for `npm run dev`.
# GENOVA_API_TARGET=http://127.0.0.1:8000
